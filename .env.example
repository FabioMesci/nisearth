# Copia este archivo como .env (en esta misma carpeta) y rellena UNA de las dos opciones.
# El archivo .env está en .gitignore: nunca se sube a GitHub. NO pongas credenciales aquí.

# Opción A (recomendada): token de https://urs.earthdata.nasa.gov -> Generate Token
EARTHDATA_TOKEN=

# Opción B: usuario y contraseña de Earthdata
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=...
